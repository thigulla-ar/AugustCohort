SENTRI_STORAGE_MODE=sqlite
SENTRI_RETENTION_DAYS=30
SENTRI_DATA_DIR=~/Documents/Sentri
SENTRI_PUBLIC_BASE_URL=http://localhost:8000
SENTRI_ALLOW_ORIGINS=["http://localhost:8000"]
# Required automatically when SENTRI_PUBLIC_BASE_URL is not loopback.
# Generate independent values with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SENTRI_API_TOKEN=
SENTRI_SIGNING_SECRET=
SENTRI_PERMIT_TTL_SECONDS=300
SENTRI_MAX_REQUEST_BYTES=1000000
SENTRI_RATE_LIMIT_REQUESTS_PER_MINUTE=120
SENTRI_MAX_DASHBOARD_SUBSCRIBERS=25
# Optional controlled provider execution. Keys remain server-side and must never
# be included in chat messages, /interact actions, or /execute requests.
SENTRI_GATEWAY_ENABLED=false
SENTRI_OPENAI_API_KEY=
SENTRI_GEMINI_API_KEY=
SENTRI_GATEWAY_ALLOWED_OPENAI_MODELS=["gpt-5.6-sol","gpt-5.6-terra","gpt-5.6-luna","gpt-5.5","gpt-5.5-pro","gpt-5.4","gpt-5.4-pro","gpt-5.4-mini","gpt-5.4-nano","gpt-5.3-codex","gpt-5.2","gpt-5.2-pro","gpt-5.1","gpt-5","gpt-5-mini"]
SENTRI_GATEWAY_ALLOWED_GEMINI_MODELS=[]
SENTRI_GATEWAY_TIMEOUT_SECONDS=60
SENTRI_GATEWAY_MAX_OUTPUT_CHARS=100000
# Rates per million tokens, keyed by provider:model. Example:
# {"openai:YOUR_MODEL":{"input_per_million":0,"output_per_million":0,"source":"operator_configured"}}
SENTRI_GATEWAY_PRICING={}
